{
  "name": "TDX-API Dev Container",
  "dockerComposeFile": "docker-compose.dev.yml",
  "service": "dev",
  "workspaceFolder": "/app/tdx-api",
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go",
        "mutantdino.resourcemonitor"
      ],
      "settings": {
        "go.goroot": "/usr/local/go",
        "go.gopath": "/go",
        "go.toolsManagement.autoUpdate": true,
        "go.useLanguageServer": true,
        "go.autocompleteUnimportedPackages": true,
        "go.gotoSymbol.includeImports": true,
        "go.toolsEnvVars": {
          "GOWORK": "/app/tdx-api/go.work"
        },
        "[go]": {
          "editor.formatOnSave": true,
          "editor.defaultFormatter": "golang.go"
        }
      }
    }
  },
  "postStartCommand": "bash -lc 'command -v /go/bin/gopls >/dev/null 2>&1 || go install golang.org/x/tools/gopls@v0.20.0; command -v /go/bin/dlv >/dev/null 2>&1 || go install github.com/go-delve/delve/cmd/dlv@latest'",
  "remoteUser": "root"
}
